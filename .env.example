# Copy this file to `.env.local` (git-ignored) and fill in your own values.
# In production, set these as real environment variables instead (see DEPLOY.md).
# NEVER commit real values. Only this example file is tracked.

# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection string from your Neon project (Connect → copy the connection string).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Local development ─────────────────────────────────────────────────────
# Lets you sign in with just a username, no Discord needed. NEVER set this in production.
DEV_AUTH=true

# ── Discord sign-in (https://discord.com/developers/applications → OAuth2) ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Addresses (the defaults below are fine for local development) ──────────
# Port the API listens on. Hosts like Render set this for you.
# PORT=8080
# Where the website lives. Discord login sends people back here.
# FRONTEND_URL=http://localhost:3001
# Where this API is reachable from the internet. Used for the Discord redirect address.
# PUBLIC_API_URL=http://localhost:8080
# Websites allowed to call the API from a browser (comma-separated). Defaults to FRONTEND_URL
# plus local dev addresses.
# ALLOWED_ORIGINS=http://localhost:3001
